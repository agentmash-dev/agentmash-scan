{
  "schema": 1,
  "updated": "2026-10-20",
  "precedence": ["trailer", "author", "message", "branch"],
  "matching": {
    "trailer": "a line `Key: value` anywhere in the message; key compared case-insensitively; name_pattern and email_pattern test the `Name <email>` parts, pattern tests the whole value",
    "author": "name_pattern / email_pattern test the commit author or committer identity",
    "message": "pattern tests the whole commit message",
    "branch": "prefix tests a branch name taken from a merge subject (`Merge pull request #N from owner/<branch>`, `Merge branch '<branch>'`); attributes the commits that merge brought in",
    "status": "only `verified` signals are applied; `unverified` ones are kept as leads and ignored"
  },
