  "automation": {
    "name_pattern": "^(dependabot|dependabot-preview|renovate|renovate-bot|github-actions|release-please|changeset-bot|changesets-bot|semantic-release-bot|pre-commit-ci|allcontributors|all-contributors|imgbot|snyk-bot|mergify|depfu|pyup-bot|greenkeeper|copybara-service|crowdin-bot|weblate|transifex-integration|stainless-app|stainless-bot)(\\[bot\\])?$|[-_ ]robot$|^GitHub Action$",
    "note": "known automation (dependency, release and CI bots): shown as a count, never an agent, left out of overlaps"
  },
  "unknown_bot": {
    "name_pattern": "(\\[bot\\]|[-_ ]bot)$",
    "note": "any other bot: printed by name so the user can see it (custom GitHub Apps like keppo-bot[bot] write features), never counted as an agent or a human"
  },
  "noise": {
    "path_pattern": "(^|/)(package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock|bun\\.lockb?|Cargo\\.lock|go\\.sum|poetry\\.lock|uv\\.lock|Gemfile\\.lock|composer\\.lock|CHANGELOG\\.md)$",
    "max_files_per_commit": 100,
    "note": "lockfiles, changelogs and commits touching more than 100 files are left out of overlaps"
  }
}
